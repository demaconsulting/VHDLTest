{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "--configuration",
        "Release",
        "${workspaceFolder}/DEMAConsulting.VHDLTest.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "--configuration",
        "Release",
        "${workspaceFolder}/DEMAConsulting.VHDLTest.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build and test",
      "dependsOn": [
        "build",
        "test"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "format",
      "command": "dotnet",
      "type": "process",
      "args": [
        "format",
        "${workspaceFolder}/DEMAConsulting.VHDLTest.sln"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "lint markdown",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "lintmark"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "spell check",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "textlint"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "setup python venv",
      "detail": "Creates .venv and installs pip-requirements.txt, as lint.ps1 and fix.ps1 do",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r pip-requirements.txt --quiet --disable-pip-version-check",
      "windows": {
        "command": "python -m venv .venv; if ($?) { .venv\\Scripts\\pip install -r pip-requirements.txt --quiet --disable-pip-version-check }"
      },
      "problemMatcher": []
    },
    {
      "label": "lint yaml",
      "dependsOn": "setup python venv",
      "command": "${workspaceFolder}/.venv/bin/yamllint",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\yamllint.exe"
      },
      "detail": "Uses the .venv that lint.ps1 and fix.ps1 create from pip-requirements.txt",
      "type": "shell",
      "args": [
        "."
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "lint all",
      "dependsOn": [
        "format",
        "lint markdown",
        "spell check",
        "lint yaml"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "test with coverage",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "--configuration",
        "Release",
        "--collect",
        "XPlat Code Coverage",
        "${workspaceFolder}/DEMAConsulting.VHDLTest.sln"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "verify requirements",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "vhdltest",
        "--validate"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
